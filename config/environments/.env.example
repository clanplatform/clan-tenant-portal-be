# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<your-db-password>
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Service Database URLs
TENANT_SERVICE_DATABASE_URL=postgresql://<user>:<pass>@<host>:5432/tenant_service
TENANT_BILLING_DATABASE_URL=postgresql://<user>:<pass>@<host>:5432/tenant_billing
TENANT_APP_CONFIG_DATABASE_URL=postgresql://<user>:<pass>@<host>:5432/tenant_app_config

# Redis
REDIS_URL=redis://:<password>@<host>:6379/0
REDIS_PASSWORD=<your-redis-password>

# JWT
# For RS256 (production): set JWT_PUBLIC_KEY to PEM-encoded RSA public key from identity service
JWT_ALGORITHM=RS256
JWT_PUBLIC_KEY=
JWT_ISSUER=clan-identity
JWT_AUDIENCE=api-gateway
# For HS256 (dev only):
SECRET_KEY=<random-32-char-secret>

# Internal service auth
INTERNAL_API_KEY=<random-secret-for-service-to-service-calls>

# App
DEBUG=false
CORS_ORIGINS=https://your-tenant-portal.example.com

# Logging
LOG_LEVEL=INFO
