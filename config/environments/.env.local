# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Service Database URLs
TENANT_SERVICE_DATABASE_URL=postgresql://postgres:postgres123@postgres:5432/tenant_service
TENANT_BILLING_DATABASE_URL=postgresql://postgres:postgres123@postgres:5432/tenant_billing
TENANT_APP_CONFIG_DATABASE_URL=postgresql://postgres:postgres123@postgres:5432/tenant_app_config

# Redis
REDIS_URL=redis://:redis123@redis:6379/0
REDIS_PASSWORD=redis123

# JWT (RS256 — set JWT_PUBLIC_KEY in production)
JWT_ALGORITHM=HS256
JWT_ISSUER=clan-identity
JWT_AUDIENCE=api-gateway
SECRET_KEY=dev-secret-key-change-in-production-must-be-32-chars-min

# Internal service auth
INTERNAL_API_KEY=dev-internal-key-change-in-production

# App
DEBUG=true
CORS_ORIGINS=*

# Logging
LOG_LEVEL=INFO
